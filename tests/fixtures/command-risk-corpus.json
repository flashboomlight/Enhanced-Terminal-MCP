  "heavyDestructive": [
    "rm -rf ./node_modules/.cache",
    "rm -rf D:\\proj\\cache",
    "Remove-Item -Recurse -Force .\\temp",
    "rd /s /q temp",
    "git clean -fdx",
    "git reset --hard"
  ],
  "heavyPerformance": ["pnpm install", "npm ci", "pnpm run ci", "vitest run", "npm publish", "pnpm test"],
  "policyRejected": ["rm -rf /", "Remove-Item -Recurse -Force D:\\x", "echo iex"],
