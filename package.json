{
  "name": "enhanced-terminal-mcp",
  "version": "3.1.0",
  "type": "module",
  "description": "Enhanced Terminal MCP Server - A powerful command-line interface for AI models with extended capabilities",
  "main": "build/index.js",
  "bin": {
    "enhanced-terminal-mcp": "build/index.js"
  },
  "files": [
    "build/",
    "es_tool/es.exe",
    "scripts/apply-mcp-sdk-patch.mjs",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsx src/index.ts",
    "postinstall": "node scripts/apply-mcp-sdk-patch.mjs",
    "patch:mcp-sdk": "node scripts/apply-mcp-sdk-patch.mjs",
    "test": "vitest run",
    "test:latency": "vitest run tests/e2e-latency.test.ts",
    "lint": "biome check src/ tests/",
    "format": "biome format --write src/ tests/",
    "lint:fix": "biome check --write src/ tests/"
  },
  "keywords": [
    "mcp",
    "terminal",
    "cli",
    "command-line",
    "model-context-protocol",
    "cherry-studio"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.6",
    "patch-package": "^8.0.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.29.0"
  }
}
