{
  "name": "enhanced-terminal-mcp",
  "version": "4.0.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "description": "Enhanced Terminal MCP Server - A powerful command-line interface for AI models with extended capabilities",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "enhanced-terminal-mcp": "build/index.js"
  },
  "files": [
    "build/",
    "scripts/apply-mcp-sdk-patch.mjs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/clean-build.mjs",
    "prepack": "npm run build",
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsx src/index.ts",
    "postinstall": "node scripts/apply-mcp-sdk-patch.mjs",
    "patch:mcp-sdk": "node scripts/apply-mcp-sdk-patch.mjs",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "test": "vitest run",
    "test:conformance": "vitest run tests/mcp-conformance.test.ts",
    "test:hostile-input": "vitest run tests/hostile-input.test.ts",
    "test:platform-smoke": "vitest run tests/platform-smoke.test.ts",
    "test:latency": "vitest run tests/e2e-latency.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:tools": "vitest run --config vitest.tools-coverage.config.ts",
    "gate": "node scripts/canonical-gate.mjs",
    "lint": "biome check src/ tests/",
    "format": "biome format --write src/ tests/",
    "lint:fix": "biome check --write src/ tests/"
  },
  "keywords": [
    "mcp",
    "terminal",
    "cli",
    "command-line",
    "model-context-protocol",
    "cherry-studio"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flashboomlight/Enhanced-Terminal-MCP.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.6",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.29.0"
  }
}
